# Default: no key, no model download. Answers are quoted from the docs.
BOT_BACKEND=extractive

# Optional: a free local LLM through Ollama (https://ollama.com), no account needed:
#   ollama pull llama3.2:3b
# BOT_BACKEND=llm
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b

# Or any OpenAI-compatible provider the client pays for:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

DOCS_DIR=docs
PRODUCT_STOPWORDS=nimbus,drive
